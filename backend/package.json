{
  "name": "wa-auto-backend",
  "version": "1.0.0",
  "description": "WhatsApp Automation Backend",
  "main": "server.js",
  "scripts": {
    "start": "node --expose-gc server.js",
    "dev": "nodemon --config nodemon.json --exec \"node --expose-gc\" server.js",
    "service": "nodemon --config nodemon.json --exec \"node --expose-gc\" whatsapp-service.js",
    "watchdog": "node resource-watchdog.js",
    "test": "set NODE_ENV=test&& jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.3",
    "google-libphonenumber": "^3.2.44",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.7",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
